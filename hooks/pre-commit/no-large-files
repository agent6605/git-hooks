#!/usr/bin/env bash
set -euo pipefail

readonly LIMIT_MB=1

skip() { [[ -n "${SKIP:-}" ]] && echo "$SKIP" | grep -qw "no-large-files"; }

main() {
  skip && exit 0

  local files
  files=$(git diff --cached --name-only --diff-filter=ACM)
  [[ -z "$files" ]] && exit 0

  local found=0
  while IFS= read -r file; do
    [[ ! -f "$file" ]] && continue
    local size
    size=$(git show :"$file" 2>/dev/null | wc -c)
    if [[ $size -gt $((LIMIT_MB * 1024 * 1024)) ]]; then
      echo "LARGE FILE: $file (${size} bytes)"
      found=1
    fi
  done <<< "$files"

  if [[ $found -eq 1 ]]; then
    echo ""
    echo "Files over ${LIMIT_MB}MB detected. Use Git LFS or .gitignore."
    echo "Skip with: SKIP=no-large-files git commit ..."
    exit 1
  fi
}

main "$@"
