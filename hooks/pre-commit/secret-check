#!/usr/bin/env bash
set -euo pipefail

readonly PATTERNS=(
  'AKIA[0-9A-Z]{16}'                    # AWS Access Key
  'sk-[a-zA-Z0-9]{20,}'                 # OpenAI / Anthropic key
  'ghp_[a-zA-Z0-9]{36}'                 # GitHub PAT
  'gho_[a-zA-Z0-9]{36}'                 # GitHub OAuth
  'xox[baprs]-[a-zA-Z0-9-]{24,}'       # Slack token
  '-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----'  # Private key
  '(password|passwd|pwd)\s*[:=]\s*\S+'  # Inline password
  '(api[_-]?key|apikey|api[_-]?secret)\s*[:=]\s*\S+'
)

skip() { [[ -n "${SKIP:-}" ]] && echo "$SKIP" | grep -qw "secret-check"; }

main() {
  skip && exit 0

  local files
  files=$(git diff --cached --name-only --diff-filter=ACM -- \
    ':!*.lock' ':!*.min.*' ':!package-lock.json' ':!yarn.lock' ':!pnpm-lock.yaml' \
    ':!poetry.lock' ':!*.svg' ':!*.png' ':!*.jpg' ':!*.woff2')

  [[ -z "$files" ]] && exit 0

  local found=0
  for file in $files; do
    [[ ! -f "$file" ]] && continue
    for pattern in "${PATTERNS[@]}"; do
      if git show :"$file" | grep -qPn "$pattern"; then
        echo "SECRET CHECK: suspicious pattern found in $file"
        echo "  pattern: $pattern"
        found=1
      fi
    done
  done

  if [[ $found -eq 1 ]]; then
    echo ""
    echo "Skip with: SKIP=secret-check git commit ..."
    exit 1
  fi
}

main
