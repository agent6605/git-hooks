{"version": 2, "width": 80, "height": 24, "timestamp": 1779056412, "env": {"SHELL": "/bin/bash", "TERM": null}}
[0.010527, "o", "\u001b[2m# git-hooks: zero-dep commit guards\u001b[0m"]
[0.011591, "o", "\r\n"]
[0.313007, "o", "\u001b[2m# Let's see it in action.\u001b[0m\r\n"]
[0.615606, "o", "\r\n"]
[1.617712, "o", "\u001b[2m# 1. Init a new repo\u001b[0m\r\n"]
[1.919283, "o", "\u001b[32m$ \u001b[0m\u001b[36mgit init demo\u001b[0m\r\n"]
[1.925135, "o", "\u001b[33mhint: Using 'master' as the name for the initial branch. This default branch name\u001b[m\r\n\u001b[33mhint: is subject to change. To configure the initial branch name to use in all\u001b[m\r\n\u001b[33mhint: of your new repositories, which will suppress this warning, call:\u001b[m\r\n\u001b[33mhint: \u001b[m\r\n\u001b[33mhint: \tgit config --global init.defaultBranch <name>\u001b[m\r\n\u001b[33mhint: \u001b[m\r\n\u001b[33mhint: Names commonly chosen instead of 'master' are 'main', 'trunk' and\u001b[m\r\n\u001b[33mhint: 'development'. The just-created branch can be renamed via this command:\u001b[m\r\n\u001b[33mhint: \u001b[m\r\n\u001b[33mhint: \tgit branch -m <name>\u001b[m\r\n"]
[1.925926, "o", "Initialized empty Git repository in /tmp/tmp.p7mkPxf8Vk/demo/.git/\r\n"]
[1.926242, "o", "\r\n"]
[2.434166, "o", "\u001b[2m# 2. One-command install\u001b[0m\r\n"]
[2.737201, "o", "\u001b[32m$ \u001b[0m\u001b[36mcurl -fsSL https://raw.githubusercontent.com/agent6605/git-hooks/main/install.sh | bash\u001b[0m\r\n"]
[2.842174, "o", "\u001b[0;36m->\u001b[0m target: /tmp/tmp.p7mkPxf8Vk/demo\r\n"]
[2.842462, "o", "\u001b[0;36m->\u001b[0m hooks:  all\r\n"]
[2.8439, "o", "\u001b[0;36m->\u001b[0m mode:   copy\r\n"]
[2.844743, "o", "\r\n"]
[2.845027, "o", "\r\n\u001b[0;32m[ok]\u001b[0m hooks installed in /tmp/tmp.p7mkPxf8Vk/demo/.git/hooks\r\n"]
[2.845183, "o", "\r\n"]
[3.8466, "o", "\u001b[2m# 3. Try to commit a secret key\u001b[0m\r\n"]
[4.148318, "o", "\u001b[32m$ \u001b[0m\u001b[36mecho \"AWS_KEY=AKIA123456789EXAMPLE\" > .env\u001b[0m\r\n"]
[4.148541, "o", "\r\n"]
[4.148647, "o", "\u001b[32m$ \u001b[0m\u001b[36mgit add .env\u001b[0m\r\n"]
[4.152872, "o", "\r\n"]
[4.152973, "o", "\u001b[32m$ \u001b[0m\u001b[36mgit commit -m \"add env file\"\u001b[0m\r\n"]
[4.163509, "o", "[master (root-commit) 16a7ce4] add env file\r\n"]
[4.16365, "o", " 1 file changed, 1 insertion(+)\r\n create mode 100644 .env\r\n"]
[4.163927, "o", "\r\n"]
[4.164021, "o", "\u001b[31m[!!]\u001b[0m Blocked! Hook caught the AWS key.\r\n"]
[6.165395, "o", "\u001b[2m# 4. Bypass with SKIP env var when intentional\u001b[0m\r\n"]
[6.466903, "o", "\u001b[32m$ \u001b[0m\u001b[36mSKIP=secret-check git commit -m \"add env\"\u001b[0m\r\n"]
[6.471208, "o", "On branch master\r\nnothing to commit, working tree clean\r\n"]
