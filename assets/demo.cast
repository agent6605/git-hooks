{"version": 2, "width": 80, "height": 24, "timestamp": 1779056237, "env": {"SHELL": "/bin/bash", "TERM": null}}
[0.012176, "o", "\u001b[2m# git-hooks: zero-dep commit guards\u001b[0m\r\n"]
[0.315914, "o", "\u001b[2m# Let's see it in action.\u001b[0m\r\n"]
[0.617328, "o", "\r\n"]
[1.618633, "o", "\u001b[2m# 1. Init a new repo\u001b[0m\r\n"]
[1.920116, "o", "\u001b[32m$ \u001b[0m\u001b[36mgit init demo\u001b[0m\r\n"]
[1.929279, "o", "\u001b[33mhint: Using 'master' as the name for the initial branch. This default branch name\u001b[m\r\n\u001b[33mhint: is subject to change. To configure the initial branch name to use in all\u001b[m\r\n\u001b[33mhint: of your new repositories, which will suppress this warning, call:\u001b[m\r\n\u001b[33mhint: \u001b[m\r\n\u001b[33mhint: \tgit config --global init.defaultBranch <name>\u001b[m\r\n\u001b[33mhint: \u001b[m\r\n\u001b[33mhint: Names commonly chosen instead of 'master' are 'main', 'trunk' and\u001b[m\r\n\u001b[33mhint: 'development'. The just-created branch can be renamed via this command:\u001b[m\r\n\u001b[33mhint: \u001b[m\r\n\u001b[33mhint: \tgit branch -m <name>\u001b[m\r\n"]
[1.929742, "o", "Initialized empty Git repository in /tmp/tmp.zloAH3rqbk/demo/.git/\r\n"]
[1.930716, "o", "\r\n"]
[2.437796, "o", "\u001b[2m# 2. One-command install\u001b[0m\r\n"]
[2.73954, "o", "\u001b[32m$ \u001b[0m\u001b[36mcurl -fsSL https://raw.githubusercontent.com/agent6605/git-hooks/main/install.sh | bash\u001b[0m\r\n"]
[2.908142, "o", "\u001b[0;36m->\u001b[0m target: /tmp/tmp.zloAH3rqbk/demo\r\n\u001b[0;36m->\u001b[0m hooks:  all\r\n"]
[2.910338, "o", "\u001b[0;36m->\u001b[0m mode:   copy\r\n"]
[2.911083, "o", "\r\n"]
[2.912067, "o", "\r\n\u001b[0;32m[ok]\u001b[0m hooks installed in /tmp/tmp.zloAH3rqbk/demo/.git/hooks\r\n"]
[2.91456, "o", "\r\n"]
[3.916674, "o", "\u001b[2m# 3. Try to commit a secret key\u001b[0m\r\n"]
[4.219777, "o", "\u001b[32m$ \u001b[0m\u001b[36mecho \"AWS_KEY=AKIA123456789EXAMPLE\" > .env\u001b[0m\r\n"]
[4.220142, "o", "\r\n\u001b[32m$ \u001b[0m\u001b[36mgit add .env\u001b[0m\r\n"]
[4.223653, "o", "\r\n"]
[4.223738, "o", "\u001b[32m$ \u001b[0m\u001b[36mgit commit -m \"add env file\"\u001b[0m\r\n"]
[4.231744, "o", "[master (root-commit) d94d381] add env file\r\n 1 file changed, 1 insertion(+)\r\n create mode 100644 .env\r\n"]
[4.232722, "o", "\r\n\u001b[31m[!!]\u001b[0m Blocked! Hook caught the AWS key.\r\n"]
[6.236308, "o", "\u001b[2m# 4. Bypass with SKIP env var when intentional\u001b[0m\r\n"]
[6.539719, "o", "\u001b[32m$ \u001b[0m\u001b[36mSKIP=secret-check git commit -m \"add env\"\u001b[0m\r\n"]
[6.543083, "o", "On branch master\r\n"]
[6.54323, "o", "nothing to commit, working tree clean\r\n"]
